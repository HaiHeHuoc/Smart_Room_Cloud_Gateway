menu "Smart Room Cloud Gateway"

    menu "Firebase development configuration"

        config APP_FIREBASE_API_KEY
            string "Firebase Web API key"
            default ""
            help
                Web API key used by Firebase Authentication. Keep the value in
                the local sdkconfig file and never commit real credentials.

        config APP_FIREBASE_DEVICE_EMAIL
            string "Firebase device account email"
            default ""
            help
                Email of the dedicated development device account.

        config APP_FIREBASE_DEVICE_PASSWORD
            string "Firebase device account password"
            default ""
            help
                Password of the dedicated development device account. This is
                compiled into development firmware and is not a production
                secret-storage design.

        config APP_FIREBASE_DEVICE_UID
            string "Expected Firebase device UID"
            default ""
            help
                Optional UID guard. Leave empty to disable exact UID checking.

    endmenu

    menu "Phase 16 automated HIL test (test branch only)"

        config APP_PHASE16_AUTO_HIL_TEST
            bool "Run bounded Phase-16 automatic arbitration HIL"
            default n
            depends on !AUDIO_MANAGER_PUBLIC_API_TEST
            help
                Starts one default-off, test-branch-only coordinator after the
                production audio manager, capture/playback arbiters, and voice
                stack reach their normal startup boundary. It uses only public
                arbitration APIs and copied status snapshots; it does not use
                GPIO/PTT input or own I2S, DMA, SD file handles, or raw audio
                buffers. Do not enable in a production image.

        config APP_PHASE16_AUTO_HIL_WAV_PATH
            string "Phase-16 automatic HIL WAV path"
            default "/sdcard/audio/input_long.wav"
            depends on APP_PHASE16_AUTO_HIL_TEST
            help
                Existing canonical PCM16 mono 16-kHz WAV on the managed SD
                filesystem. The harness passes this copied path to the public
                playback arbiter; it does not open or write the file itself.

    endmenu

endmenu
